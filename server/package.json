{
  "name": "@korean-tales/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "start:deploy": "prisma db push --skip-generate && tsx src/index.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@korean-tales/shared": "*",
    "@prisma/client": "^6.19.3",
    "argon2": "^0.44.0",
    "fastify": "^5.10.0",
    "prisma": "^6.19.3",
    "socket.io": "^4.8.0",
    "tsx": "^4.19.0",
    "xstate": "^5.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "socket.io-client": "^4.8.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.0"
  }
}
