# SQLite 파일 경로 — Render 배포 시 영구 디스크 마운트 경로(/data)를 가리키게 한다
# 로컬 개발:   file:./dev.db
# Render 배포: file:/data/korean_tales.db
DATABASE_URL="file:./dev.db"

# 서버 포트 (Render는 PORT를 자동 주입)
PORT=4000

# 프로덕션에서 쿠키 Secure 플래그 활성화
# NODE_ENV=production

# 게스트 플레이 차단 스위치 — requirements 9번에서 게스트 허용 여부 미정.
# 현재 기본값은 허용(미설정)이며, 차단으로 확정되면 true로 켠다.
# REQUIRE_AUTH=true
