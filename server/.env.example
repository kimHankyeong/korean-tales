# ── korean_tales 서버 환경변수 예시 ─────────────────────────────
# 사용법: 이 파일을 server/.env로 복사한 뒤 값을 채운다 (.env는 gitignore됨)

# SQLite 파일 경로 — Render 배포 시 영구 디스크 마운트 경로(/data)를 가리키게 한다
# 로컬 개발:   file:./dev.db
# Render 배포: file:/data/korean_tales.db  (render.yaml의 disk.mountPath와 일치)
DATABASE_URL="file:./dev.db"

# 서버 포트 (Render는 PORT를 자동 주입하므로 배포 시 설정 불필요)
PORT=4000

# 아바타 업로드 저장 경로 — Render에서는 영구 디스크 하위(/data/uploads)를 가리키게 한다
# 로컬 개발:   ./uploads (기본값)
# Render 배포: /data/uploads
# UPLOADS_DIR=./uploads

# CORS 허용 오리진 — 쉼표로 여러 개 지정 가능. 미설정 시 전체 허용(개발용).
# 배포 시 반드시 클라이언트 도메인으로 제한할 것.
# CLIENT_ORIGIN=https://korean-tales.example.com

# 프로덕션 표시(쿠키를 쓰지 않으므로 세션 자체엔 영향 없음)
# NODE_ENV=production

# 게스트 플레이 차단 스위치 — requirements 9번에서 게스트 허용 여부 미정.
# 현재 기본값은 허용(미설정)이며, 차단으로 확정되면 true로 켠다.
# REQUIRE_AUTH=true

# 관리자 계정 이메일 (쉼표 구분) — 정원 미달이어도 게임을 시작해 혼자 테스트할 수 있다.
# ADMIN_EMAILS=you@example.com
